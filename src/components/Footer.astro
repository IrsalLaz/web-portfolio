---
import { site } from "../data/site";
import { useTranslations, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const now = new Date();
const year = now.getFullYear();
const updated = now.toLocaleString(lang === "id" ? "id-ID" : "en-US", { month: "long", year: "numeric", timeZone: "Asia/Jakarta" });
---

<footer class="site-footer">
  <div class="container">
    <hr />
    <p class="line">
      <span>© {year} {site.name}</span>
      <span class="spark" aria-hidden="true">✺</span>
      <span>{t("footer.updated")}: <span class="u">{updated}</span></span>
    </p>
    <ul class="links">
      <li><a href={`mailto:${site.email}`}>{t("footer.email")}</a></li>
      <li><a href={site.links.linkedin} rel="me noopener" target="_blank">LinkedIn ↗</a></li>
      <li><a href={site.links.github} rel="me noopener" target="_blank">GitHub ↗</a></li>
      <li><a href="/cv">CV</a></li>
    </ul>
    <p class="fine">{t("footer.fine")}</p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 48px 40px;
  }

  hr {
    border: 0;
    border-top: 1px solid var(--line);
    margin: 0 0 24px;
  }

  .line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 8px 16px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-2);
    text-align: center;
  }

  .spark {
    color: var(--faint);
    font-size: 1rem;
  }

  .u {
    border-bottom: 1px solid var(--ink-2);
    padding-bottom: 2px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px 4px;
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .fine {
    margin: 10px 0 0;
    text-align: center;
    font-size: 0.78rem;
    color: var(--faint);
  }
</style>
