---
// Framed square portrait. Shows src/assets/profile.(jpg|jpeg|png|webp) if present; otherwise a monogram placeholder.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { site } from "../data/site";

interface Props {
  size?: number;
}
const { size = 196 } = Astro.props;

const found = import.meta.glob<{ default: ImageMetadata }>("../assets/profile.{jpg,jpeg,png,webp}", { eager: true });
const photo = Object.values(found)[0]?.default;
---

<div class="frame" style={`--size:${size}px`}>
  {
    photo ? (
      <Image src={photo} alt={`Portrait of ${site.name}`} width={size * 2} height={size * 2} format="webp" quality={85} loading="eager" />
    ) : (
      <span class="monogram" role="img" aria-label={`${site.name} (photo placeholder)`}>
        {site.initials}
      </span>
    )
  }
</div>

<style>
  .frame {
    width: var(--size);
    height: var(--size);
    padding: 7px;
    border: 1.5px solid var(--frame);
    background: var(--bg);
    flex: none;
  }

  .frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .monogram {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--accent-tint);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: calc(var(--size) * 0.32);
    letter-spacing: -0.06em;
  }
</style>
