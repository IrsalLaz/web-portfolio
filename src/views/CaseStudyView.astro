---
import { render, type CollectionEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations, type Lang } from "../i18n/ui";
import { localizePath } from "../i18n/utils";

interface Props {
  lang: Lang;
  entry: CollectionEntry<"projects">;
  prev?: CollectionEntry<"projects">;
  next?: CollectionEntry<"projects">;
}

const { lang, entry, prev, next } = Astro.props;
const t = useTranslations(lang);
const L = (p: string) => localizePath(p, lang);
const slugOf = (id: string) => id.split("/")[1];
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const num = String(entry.data.order).padStart(2, "0");
---

<BaseLayout lang={lang} title={entry.data.title} description={entry.data.description} ogType="article">
  <article>
    <header class="container case-head">
      <a class="back mono" href={L("/projects")}><span aria-hidden="true">←</span> {t("case.all")}</a>
      <p class="label label-accent">{t("case.number")} {num} · {entry.data.category}</p>
      <h1 class="page-title">{entry.data.title}</h1>
      <p class="lead">{entry.data.summary}</p>
      {
        entry.data.status && (
          <p class="chip status-chip">
            <span class="dot" aria-hidden="true" />
            {entry.data.status}
          </p>
        )
      }
      <dl class="facts">
        {
          entry.data.facts.map((f) => (
            <div>
              <dt class="label">{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="container case-body">
      <nav class="toc" aria-label={t("case.toc")}>
        <details open>
          <summary class="label">{t("case.toc")}</summary>
          <ol>
            {
              toc.map((h, i) => (
                <li>
                  <a href={`#${h.slug}`}>
                    <span class="n">{String(i + 1).padStart(2, "0")}</span>
                    {h.text}
                  </a>
                </li>
              ))
            }
          </ol>
        </details>
      </nav>
      <div class="content">
        <Content />
        <p class="note">{t("case.note")}</p>
      </div>
    </div>

    <div class="container pager-wrap">
    <nav class="pager" aria-label={t("proj.list")}>
      {
        prev ? (
          <a class="pager-link" href={L(`/projects/${slugOf(prev.id)}`)} rel="prev">
            <span class="label">{t("case.prev")}</span>
            <span class="pt">{prev.data.title}</span>
          </a>
        ) : (
          <a class="pager-link" href={L("/projects")}>
            <span class="label">{t("case.back")}</span>
            <span class="pt">{t("case.all")}</span>
          </a>
        )
      }
      {
        next ? (
          <a class="pager-link next" href={L(`/projects/${slugOf(next.id)}`)} rel="next">
            <span class="label">{t("case.next")}</span>
            <span class="pt">{next.data.title}</span>
          </a>
        ) : (
          <a class="pager-link next" href={L("/projects#more-work")}>
            <span class="label">{t("case.next")}</span>
            <span class="pt">{t("case.more")}</span>
          </a>
        )
      }
    </nav>
    </div>
  </article>
</BaseLayout>

<style>
  .case-head {
    padding-block: clamp(32px, 5vw, 56px) clamp(32px, 4vw, 48px);
  }

  .back {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    min-height: 44px;
    margin-bottom: 24px;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--muted);
  }

  .back:hover {
    color: var(--ink);
  }

  .page-title {
    margin-top: 16px;
    max-width: 16ch;
  }

  .status-chip {
    margin: 24px 0 0;
  }

  .facts {
    display: grid;
    margin: 36px 0 0;
    border-top: 1px solid var(--frame);
    border-left: 1px solid var(--frame);
  }

  @media (min-width: 760px) {
    .facts {
      grid-template-columns: repeat(2, 1fr);
    }
    .facts div:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .facts div {
    padding: 18px 20px;
    border-right: 1px solid var(--frame);
    border-bottom: 1px solid var(--frame);
  }

  .facts dd {
    margin: 6px 0 0;
    color: var(--ink-2);
  }

  .case-body {
    display: grid;
    gap: 28px;
    padding-block: clamp(36px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  @media (min-width: 1024px) {
    .case-body {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: 72px;
    }
    .toc {
      position: sticky;
      top: calc(var(--header-h) + 28px);
      align-self: start;
    }
  }

  .toc details {
    border: 1px solid var(--frame);
  }

  @media (min-width: 1024px) {
    .toc details {
      border: 0;
    }
  }

  .toc summary {
    cursor: pointer;
    min-height: 44px;
    display: flex;
    align-items: center;
    padding: 0 14px;
  }

  @media (min-width: 1024px) {
    .toc summary {
      padding: 0;
    }
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0 0 6px;
  }

  .toc a {
    display: flex;
    gap: 12px;
    padding: 8px 14px;
    border-left: 2px solid var(--line);
    color: var(--muted);
    font-size: 0.92rem;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--ink);
    border-left-color: var(--accent);
    background: var(--accent-tint);
  }

  .toc .n {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent-ink);
    padding-top: 3px;
  }

  .content {
    min-width: 0;
    max-width: 820px;
  }

  .content :global(h2) {
    font-size: clamp(1.8rem, 1.6vw + 1.1rem, 2.4rem);
    letter-spacing: -0.055em;
    margin: 3.2rem 0 1.1rem;
  }

  .content :global(h2:first-child) {
    margin-top: 0;
  }

  .content :global(p),
  .content :global(ul),
  .content :global(ol) {
    max-width: var(--prose);
    color: var(--ink-2);
  }

  .content :global(ul) {
    padding-left: 1.1rem;
    margin: 0 0 1em;
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(li::marker) {
    color: var(--accent);
  }

  .content :global(strong) {
    font-weight: 600;
    color: var(--ink);
  }

  .content :global(a) {
    color: var(--accent-ink);
  }

  .note {
    margin-top: 3rem;
  }

  .pager-wrap {
    padding-bottom: clamp(24px, 4vw, 40px);
  }

  .pager {
    display: grid;
    border-top: 1px solid var(--frame);
    border-left: 1px solid var(--frame);
  }

  @media (min-width: 700px) {
    .pager {
      grid-template-columns: 1fr 1fr;
    }
  }

  .pager-link {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 28px;
    border-right: 1px solid var(--frame);
    border-bottom: 1px solid var(--frame);
    text-decoration: none;
    color: var(--ink);
    transition: background-color 0.15s ease;
  }

  .pager-link:hover {
    background: var(--accent-tint);
  }

  .pt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.4rem;
    letter-spacing: -0.05em;
  }

  .pager-link.next {
    text-align: right;
    align-items: flex-end;
  }
</style>
