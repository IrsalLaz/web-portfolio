---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="container nf">
    <p class="label label-accent">404</p>
    <h1>This page doesn't exist.</h1>
    <p>The link may be old, or the address may have a typo.</p>
    <p><a class="btn" href="/">Back to home</a></p>
  </section>
</BaseLayout>

<style>
  .nf {
    padding-block: clamp(64px, 12vw, 140px);
    max-width: 640px;
  }
  h1 {
    font-size: clamp(2.6rem, 5vw + 1rem, 4rem);
    letter-spacing: -0.06em;
    margin-bottom: 1rem;
  }
  p {
    color: var(--muted);
  }
</style>
